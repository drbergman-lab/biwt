# Python build artifacts
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# Test scripts (not part of the package)
/test_biwt.py

# Standalone hosts for driving BIWT by hand. They exist to be edited during a
# testing session — a tracked copy would collect everyone's local edits.
/scratch_*.py

# Icon masters (~3 MB, ~7000 px). scripts/make_icons.py derives the committed
# assets from them; the originals buy nothing in the sdist or in a clone.
/biwt_icon*.png

# Miscellaneous
*.DS_Store

# R test fixtures regenerated on every CI run (see tests/fixtures/make_fixtures.R)
tests/fixtures/toy_*.rds
# Coverage data, when run from the repo root
/.coverage

# MkDocs build output
site/
# Social-card renderer cache (fonts, rendered cards)
.cache/

# Generated documentation-screenshot data (see scripts/make_screenshot_data.py)
screenshot_data.h5ad
screenshot_deconv.h5ad

# Handoff note for the PhysiCell Studio session — an artifact of the 0.5 API
# change, not documentation. See docs/integration/ for the durable host guide.
/host-migration-v0.5.md
/manual-test-plan.md
